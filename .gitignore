# ==============================================================================
# Node.js & Monorepo Gitignore
# ==============================================================================

# --- Dependências ---
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# --- Build de Produção ---
dist/
dist-ssr/
build/
out/
.next/
.nuxt/
.turbo/

# --- Variáveis de Ambiente (SEGURANÇA CRÍTICA) ---
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
*.local

# --- Logs do Sistema ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Sistema Operacional (Mac/Windows/Linux) ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- IDEs e Editores ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# --- Testes e Cobertura ---
coverage/
.nyc_output/

# --- Docker ---
# .dockerignore é versionado: sem ele o build copia node_modules do host.
docker-compose.override.yml

# --- Caches e Arquivos Temporários ---
.eslintcache
.stylelintcache
.npm
.yarn-integrity
.cache/
.parcel-cache/
pids/
*.pid
*.seed
*.pid.lock
