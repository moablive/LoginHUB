# ==========================================
# ⚙️ CONFIGURAÇÃO DO SERVIDOR (API)
# ==========================================
# NODE_ENV é definido pelo docker-compose (environment); o Vite recusa esta
# variável no .env e o build da UI emite warning se ela ficar aqui.
PORT=3000
TZ=America/Sao_Paulo

# ==========================================
# 🗄️ BANCO DE DADOS (Conexão Interna)
# ==========================================
DB_HOST=server_db_postgres
DB_PORT=5432
DB_NAME=login_hub
DB_USER=admin_root
DB_PASSWORD=

# ==========================================
# 🔐 SEGURANÇA E CHAVES
# ==========================================
JWT_SECRET=

# UI / API Master Key
MASTER_API_KEY=

# ==========================================
# 🌐 DOMÍNIOS PÚBLICOS E CLIENTE (React/Vite)
# ==========================================
API_PUBLIC_URL=https://loginhub.astralwavelabel.com
UI_PUBLIC_URL=https://loginhub.astralwavelabel.com

# IMPORTANTE: Deve ser a URL pública HTTPS do Cloudflare.
# A API é servida pelo nginx da própria UI em /api (apps/ui/nginx.conf), então
# painel e API compartilham o hostname. O antigo api-auth.astralwavelabel.com
# foi descontinuado.
VITE_API_URL=https://loginhub.astralwavelabel.com/api

# ==========================================
# 📧 SERVIÇO DE E-MAIL (SMTP) - Ativo para convites
# ==========================================
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# App 2 — Sul Alimentos
SMTP_APP_2_FROM=
SMTP_APP_2_USER=
SMTP_APP_2_PASS=

# ====================
# 2FA (TOTP)
# ====================
# Chave de 32 bytes em hex. Cifra o secret TOTP (AES-256-GCM) e serve de pepper
# no HMAC dos códigos de recuperação. Sem aspas de propósito: hex não tem
# caractere especial, e o env_file entregaria as aspas como parte do valor.
# ⚠️ Trocar esta chave torna ilegíveis todos os secrets e backup codes já gravados.
TWOFA_ENC_KEY=
# 2FA e exigido de TODAS as contas — nao ha configuracao por app.

# ====================
# CORS
# ====================
# Origens permitidas ALÉM de *.astralwavelabel.com, separadas por vírgula.
# Aceita origem exata (https://app.exemplo.com) ou curinga (*.exemplo.com).
CORS_EXTRA_ORIGINS=*.sulalimentos.com



# Fase 2 — emissao de sessao delegada (dedicada; nao e a BOT_SERVICE_KEY).
HUB_DELEGATION_KEY=
HUB_DELEGATION_ALLOWED_APPS=3

# ==========================================
# 🏷️ VERSÃO DO BUILD
# ==========================================
# Não editar à mão: quem escreve estas duas chaves é o scripts/bump-version.mjs,
# a partir do arquivo VERSION (a fonte da verdade, versionada no git).
#
# O docker-compose entrega APP_VERSION para a api (health check em GET /api) e
# a mesma string como VITE_APP_VERSION para a ui (badge + aviso de update).
# Sem elas os dois lados caem em 0.0.0, que o front trata como "sem baseline" e
# ignora — o aviso simplesmente não aparece, em vez de aparecer errado.
APP_VERSION=0.0.0
APP_BUILD_DATE=
